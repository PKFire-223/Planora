# Server configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/personal_lms or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/personal_lms

# Gemini AI API Key (Server-side only for Study Assistant & Summarization)
GEMINI_API_KEY=

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
